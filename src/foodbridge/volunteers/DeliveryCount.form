          <SubComponents>
            <Component class="javax.swing.JTextArea" name="jTextArea1">
              <Properties>
                <Property name="background" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                  <Color blue="d8" green="fc" red="ff" type="rgb"/>
                </Property>
                <Property name="columns" type="int" value="20"/>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Segoe UI" size="16" style="0"/>
                </Property>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="Thank you for your service! &#xa;Your diligence and willingness to help&#xa;are truly amazing. We hope you don&apos;t stop here.&#xa;You now have the opportunity to make multiple &#xa;deliveries and continue helping more people. &#xa;This page lets you keep track of how many &#xa;deliveries you&apos;ve completed. With enough &#xa;deliveries, you may become eligible for an award&#xa;from the UN. This can be a positive opportunity for&#xa;both you and your community.&#xa;&#xa;So keep making those deliveries!"/>
              </Properties>
            </Component>
          </SubComponents>
